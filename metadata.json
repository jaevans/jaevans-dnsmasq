{
  "name": "jaevans-dnsmasq",
  "version": "0.1.0",
  "author": "James Evans",
  "summary": "Hiera-driven management of dnsmasq DNS, DHCP and PXE using per-type conf-dir files",
  "license": "Apache-2.0",
  "source": "https://github.com/jaevans/jaevans-dnsmasq",
  "project_page": "https://github.com/jaevans/jaevans-dnsmasq",
  "issues_url": "https://github.com/jaevans/jaevans-dnsmasq/issues",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.0.0 < 11.0.0"
    },
    {
      "name": "puppetlabs/concat",
      "version_requirement": ">= 9.0.0 < 11.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": ["12", "13"]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": ["22.04", "24.04", "26.04"]
    },
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": ["10"]
    },
    {
      "operatingsystem": "AlmaLinux",
      "operatingsystemrelease": ["10"]
    },
    {
      "operatingsystem": "Rocky",
      "operatingsystemrelease": ["10"]
    }
  ],
  "requirements": [
    {
      "name": "openvox",
      "version_requirement": ">= 8.0.0 < 10.0.0"
    }
  ],
  "tags": ["dnsmasq", "dns", "dhcp", "pxe", "tftp"]
}
